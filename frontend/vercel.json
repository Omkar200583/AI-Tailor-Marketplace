{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "ai-engine": {
      "root": "ai-engine",
      "framework": "fastapi"
    },
    "backend": {
      "root": "backend",
      "framework": "express",
      "bindings": [
        {
          "type": "service",
          "service": "ai-engine",
          "format": "url",
          "env": "AI_ENGINE_URL"
        }
      ]
    },
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
