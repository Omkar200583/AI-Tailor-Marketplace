generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// AI TAILOR PLATFORM — Database Schema
// Mirrors the MongoDB collection design (users, seller_profiles,
// designer_profiles, products, orders, order_items, conversations,
// messages, designs, tryon_sessions, body_profiles, reviews,
// notifications, commissions). JSON-ish fields are stored as
// serialized strings for SQLite compatibility.
// ─────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid()) @map("_id")
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         String   @default("CUSTOMER")
  profileImage String?
  avatarColor  String   @default("#7C2D3E")
  city         String?
  isVerified   Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sellerProfile   SellerProfile?
  designerProfile DesignerProfile?
  bodyProfile     BodyProfile?

  cartItems      CartItem[]
  wishlistItems  WishlistItem[]
  orders         Order[]         @relation("CustomerOrders")
  messages       Message[]
  conversations  Conversation[] @relation("CustomerConversations")
  reviews        Review[]
  designs        Design[]
  tryonSessions  TryonSession[]
  notifications  Notification[]

  customerAddresses CustomerAddress[]
}


model SellerProfile {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopName          String
  description       String    @default("")
  contactNumber     String?
  whatsappNumber    String?
  shopImage         String?
  address           String    @default("")
  city              String    @default("Pune")
  lat               Float     @default(18.5204)
  lng               Float     @default(73.8567)
  services          String    @default("[]")
  specialization    String    @default("Ethnic Wear")
  experienceYears   Int       @default(1)
  rating            Float     @default(0)
  ratingCount       Int       @default(0)
  verificationStatus String   @default("PENDING")
  availability      String    @default("Mon-Sat, 9AM-8PM")
  portfolio         String    @default("[]")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  products          Product[]
  orders            Order[]   @relation("SellerOrders")
  reviews           Review[]
  conversations     Conversation[] @relation("SellerConversations")
}

model DesignerProfile {
  id              String  @id @default(cuid()) @map("_id")
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String  @default("Fashion Designer")
  bio             String  @default("")
  specialty       String  @default("Bridal Couture")
  city            String  @default("Pune")
  lat             Float   @default(18.5204)
  lng             Float   @default(73.8567)
  experienceYears Int     @default(3)
  rating          Float   @default(0)
  ratingCount     Int     @default(0)
  portfolioImage  String?
  createdAt       DateTime @default(now())
}

model Category {
  id          String @id @default(cuid()) @map("_id")
  name        String @unique
  slug        String @unique
  icon        String @default("👕")
  description String @default("")
  sortOrder   Int    @default(0)
  products    Product[]
}

model Product {
  id                    String   @id @default(cuid()) @map("_id")
sellerId String @db.ObjectId
  seller                SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId            String
  category              Category @relation(fields: [categoryId], references: [id])
  name                  String
  description           String   @default("")
  fabric                String   @default("Cotton")
  images                String   @default("[]") // JSON array of urls
  colors                String   @default("[]") // JSON array
  sizes                 String   @default("[]") // JSON array
  price                 Float
  stitchingPrice        Float?
  customizationAvailable Boolean @default(true)
  deliveryDays          Int      @default(7)
  stock                 Int      @default(10)
  status                String   @default("ACTIVE") // ACTIVE | PENDING | HIDDEN
  isFeatured            Boolean  @default(false)
  rating                Float    @default(0)
  ratingCount           Int      @default(0)
  soldCount             Int      @default(0)
  tags                  String   @default("[]") // JSON array
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  cartItems    CartItem[]
  wishlistItems WishlistItem[]
  orderItems   OrderItem[]
  reviews      Review[]
}

model BodyProfile {
  id           String   @id @default(cuid()) @map("_id")
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  height       Float?
  weight       Float?
  chest        Float?
  waist        Float?
  hip          Float?
  shoulder     Float?
  sleeveLength Float?
  unit         String   @default("cm")
  updatedAt    DateTime @updatedAt
}

model CartItem {
  id        String   @id @default(cuid()) @map("_id")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String   @default("M")
  color     String   @default("")
  quantity  Int      @default(1)
  note      String   @default("")
  withStitching Boolean @default(false)
  createdAt DateTime @default(now())
  @@unique([userId, productId, size, color])
}

model WishlistItem {
  id        String   @id @default(cuid()) @map("_id")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, productId])
}

model Order {
  id            String   @id @default(cuid()) @map("_id")
  orderNumber   String   @unique

  customerId    String
  customer      User     @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Cascade)

  sellerId      String   @db.ObjectId
  seller        SellerProfile @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Cascade)

  status        String   @default("REQUESTED")

  totalAmount   Float    @default(0)
  commission    Float    @default(0)
  sellerEarning Float    @default(0)

  paymentStatus String   @default("UNPAID")
  paymentMethod String   @default("")

  advanceAmount   Float  @default(0)
  advancePaid     Float  @default(0)
  remainingAmount Float  @default(0)

  advanceStatus String @default("UNPAID")
  finalStatus   String @default("UNPAID")

  deliveryDate DateTime?
  address      String   @default("")
  notes        String   @default("")

  deliveryAddressJson Json?

  idempotencyKey String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       OrderItem[]
  reviews     Review[]

  measurements OrderMeasurement?
  design       OrderDesign?

  payments      PaymentTransaction[]
  statusHistory OrderStatusHistory[]
  timeline      ProductionTimeline?

  @@index([customerId])
  @@index([sellerId])
  @@index([status])
  @@index([createdAt])
}


model OrderItem {
  id          String  @id @default(cuid()) @map("_id")
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  name        String
  image       String  @default("")
  price       Float
  size        String  @default("M")
  color       String  @default("")
  quantity    Int     @default(1)
  withStitching Boolean @default(false)
  customization String  @default("")
}

model OrderMeasurement {
  id      String @id @default(cuid()) @map("_id")
  orderId String @unique

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  unit   String @default("cm")

  height       Float?
  weight       Float?
  chest        Float?
  waist        Float?
  hip          Float?
  shoulder     Float?
  sleeveLength Float?
  neck         Float?
  armhole      Float?
  inseam       Float?
  outseam      Float?

  raw Json?

  createdAt DateTime @default(now())
}

model Conversation {
  id           String   @id @default(cuid()) @map("_id")
  customerId   String
  customer     User     @relation("CustomerConversations", fields: [customerId], references: [id], onDelete: Cascade)
 sellerId String @db.ObjectId
  seller       SellerProfile @relation("SellerConversations", fields: [sellerId], references: [id], onDelete: Cascade)
  lastMessage  String   @default("")
  lastMessageAt DateTime @default(now())
  createdAt    DateTime @default(now())
  messages     Message[]
  @@unique([customerId, sellerId])
}

model Message {
  id             String   @id @default(cuid()) @map("_id")
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  type           String   @default("TEXT") // TEXT | PRODUCT | ORDER | IMAGE
  refId          String?  // productId or orderId when type is PRODUCT/ORDER
  createdAt      DateTime @default(now())
}

model Review {
  id         String   @id @default(cuid()) @map("_id")
  customerId String
  customer   User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
 sellerId String @db.ObjectId
  seller     SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product? @relation(fields: [productId], references: [id])
  orderId    String?
  order      Order?   @relation(fields: [orderId], references: [id])
  rating     Int
  comment    String   @default("")
  createdAt  DateTime @default(now())
}

model Design {
  id        String   @id @default(cuid()) @map("_id")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("AI Design")
  prompt    String
  category  String   @default("Kurta")
  colors    String   @default("[]")
  fabric    String   @default("")
  imageUrl  String   @default("")
  status    String   @default("GENERATED") // GENERATED | SAVED | SENT_TO_TAILOR
  sentToSellerId String?
  createdAt DateTime @default(now())
}

model TryonSession {
  id           String   @id @default(cuid()) @map("_id")
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId    String?
  productName  String   @default("")
  productImage String   @default("")
  resultImage  String   @default("")
  status       String   @default("COMPLETED")
  createdAt    DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid()) @map("_id")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String   @default("")
  type      String   @default("INFO") // INFO | ORDER | MESSAGE | PAYMENT | AI
  refId     String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model CommissionLog {
  id          String   @id @default(cuid()) @map("_id")
  orderId     String
  orderNumber String
  sellerId    String
  amount      Float
  rate        Float    @default(0.05)
  createdAt   DateTime @default(now())
}


model ProductionTimeline {
  id      String @id @default(cuid()) @map("_id")
  orderId String @unique

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  startDate           DateTime?
  estimatedCompletion DateTime?
  expectedDispatch    DateTime?

  updatedAt DateTime @updatedAt
}


model OrderStatusHistory {
  id      String @id @default(cuid()) @map("_id")
  orderId String

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status  String
  note    String?
  actorId String?

  createdAt DateTime @default(now())

  @@index([orderId])
}


model PaymentTransaction {
  id      String @id @default(cuid()) @map("_id")
  orderId String

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  razorpayOrderId   String? @unique
  razorpayPaymentId String?
  razorpaySignature String?

  kind   String
  amount Float

  status String @default("PENDING")
  method String?

  receiptUrl     String?
  failureReason String?

  createdAt  DateTime @default(now())
  verifiedAt DateTime?

  @@index([orderId])
}


model OrderDesign {
  id      String @id @default(cuid()) @map("_id")
  orderId String @unique

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  designId  String?
  productId String?

  title         String
  imageUrl      String
  category      String?
  fabric        String?
  color         String?
  customization String?

  createdAt DateTime @default(now())
}


model CustomerAddress {
  id         String   @id @default(cuid()) @map("_id")

  customerId String
  customer   User     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  fullName String
  phone    String
  line1    String
  line2    String?
  landmark String?

  city    String
  state   String
  pincode String

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}
