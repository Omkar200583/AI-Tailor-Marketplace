# --- Security (same value must be set in the Node.js backend) ---
INTERNAL_API_KEY=change-this-long-random-secret

# --- MongoDB (same DB as Node.js backend) ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=ai_tailor
PRODUCTS_COLLECTION=products

# --- LLM (Assistant). Groq is primary, Gemini is fallback ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Hugging Face (image generation + virtual try-on Space) ---
HF_TOKEN=
IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
TRYON_SPACE=yisol/IDM-VTON
TRYON_API_NAME=/tryon

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Product field mapping (change if your Mongo schema differs) ---
REQUIRE_AVAILABLE=true
